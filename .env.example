# Supabase — כושר פלוס / Fitness Plus
# אופציונלי ל־M1α scaffold; חובה ל־M1β auth + persist
# Optional for M1α UI scaffold; required for M1β auth + onboarding persist
# העתיקו ל־.env מקומי ומלאו מ־Supabase Dashboard → Settings → API
# Copy to local .env; fill from Supabase Dashboard → Settings → API
# לעולם אל תשימו service_role כאן — רק anon + RLS
# Never put service_role here — anon key + RLS only

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
